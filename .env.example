# Copy to .env and fill in. Never commit the filled file.

# ---------- Smplixit Core ----------
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o
DEFAULT_TARGET_GRADE=6
MAX_REWRITE_ATTEMPTS=3
GRADE_TOLERANCE=0.5

# ---------- Smplixit Poly ----------
DEEPL_API_KEY=replace-me
# Free tier keys must point at the free host. Pro keys use https://api.deepl.com
DEEPL_API_HOST=https://api-free.deepl.com

# ---------- Smplixit Guard ----------
# Optional. Without it openFDA allows 240 requests/min from one IP.
OPENFDA_API_KEY=
OPENFDA_BASE_URL=https://api.fda.gov

# ---------- Shared ----------
DATABASE_URL=postgresql+asyncpg://smplixit:smplixit@localhost:5432/smplixit
CORE_SERVICE_URL=http://localhost:8001
POLY_SERVICE_URL=http://localhost:8002
GUARD_SERVICE_URL=http://localhost:8003
LOG_LEVEL=INFO
ENVIRONMENT=local

# ---------- Web ----------
NEXT_PUBLIC_CORE_API_URL=http://localhost:8001
NEXT_PUBLIC_POLY_API_URL=http://localhost:8002
NEXT_PUBLIC_GUARD_API_URL=http://localhost:8003

# ---------- SMART on FHIR ----------
FHIR_CLIENT_ID=replace-me
FHIR_ISSUER=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
FHIR_REDIRECT_URI=http://localhost:3000/api/fhir/callback
FHIR_SCOPES=launch openid fhirUser patient/Patient.read patient/DocumentReference.read

# ---------- AWS (deploy only) ----------
AWS_REGION=us-east-1
S3_EXPORT_BUCKET=smplixit-instruction-exports
