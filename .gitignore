# ---------------------------------------------------------------------------
# Proprietary engine modules.
#
# The rewrite pipeline and the grade-level constraint logic are the
# differentiated part of this product and are not distributed with the repo.
# Each has a tracked `.template.py` counterpart that implements the same public
# interface at reference quality, so a clean clone still builds, boots, and
# passes CI. Run `npm run bootstrap:engine` after cloning.
# ---------------------------------------------------------------------------
services/core/app/engine/prompt_builder.py
services/core/app/engine/rewriter.py
services/core/app/engine/rubrics/*.json
!services/core/app/engine/rubrics/*.example.json

